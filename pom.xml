<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.guitarmony</groupId>
  <artifactId>guitarmony</artifactId>
  <version>1.0.0</version>
  <name>Guitarmony</name>
  <description>Estudo visual de harmonia para guitarra, offline e sem áudio.</description>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <finalName>Guitarmony</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>theory-and-fretboard-checks</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.guitarmony.TheoryChecks</mainClass>
              <classpathScope>test</classpathScope>
              <systemProperties>
                <systemProperty><key>java.awt.headless</key><value>true</value></systemProperty>
              </systemProperties>
            </configuration>
          </execution>
          <execution>
            <id>interactive-workspace-checks</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.guitarmony.UiSmokeTest</mainClass>
              <classpathScope>test</classpathScope>
              <systemProperties>
                <systemProperty><key>java.awt.headless</key><value>true</value></systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <outputDirectory>${project.basedir}/dist</outputDirectory>
          <archive><manifest><mainClass>com.guitarmony.GuitarmonyApp</mainClass></manifest></archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
